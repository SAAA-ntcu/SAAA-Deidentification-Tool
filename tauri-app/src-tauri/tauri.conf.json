{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAAA-Deidentification-Tool",
  "version": "2.1.0",
  "identifier": "edu.ntcu.saaa.deidentification",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": null,
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "SAAA學生學習能力檢測去識別化工具 v2.0",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
